html, body {
  margin: 0;
  padding: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: #f9f3e8;
  color: #2b1c1c;
}

* {
  box-sizing: border-box;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

button,
input,
textarea {
  font: inherit;
}

.container {
  width: min(1200px, calc(100% - 32px));
  margin: 0 auto;
}

.page-shell {
  background: #f9f3e8;
}

.site-header {
  background: #2b1c1c;
  color: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 0;
}

.brand {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 24px;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 600;
}

.primary-button,
.secondary-button {
  border: none;
  border-radius: 999px;
  padding: 14px 24px;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-1px);
}

.primary-button {
  background: #d4a648;
  color: #2b1c1c;
}

.secondary-button {
  background: transparent;
  color: #2b1c1c;
  border: 2px solid #d4a648;
}

.hero {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  align-items: center;
  gap: 48px;
  padding: 78px 0 70px;
}

.hero-copy h1 {
  font-size: clamp(2.6rem, 4vw, 4.8rem);
  line-height: 1.05;
  margin: 14px 0 18px;
}

.hero-copy p {
  font-size: 1.08rem;
  line-height: 1.7;
  color: #50413f;
}

.eyebrow {
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: #7a1f1f;
}

.eyebrow.light {
  color: #d4a648;
}

.hero-actions {
  display: flex;
  gap: 16px;
  margin-top: 28px;
  flex-wrap: wrap;
}

.hero-image-wrap img {
  width: 100%;
  height: 500px;
  object-fit: cover;
  border-radius: 32px;
  box-shadow: 0 25px 50px rgba(19, 11, 11, 0.12);
}

.section-spacing {
  padding-top: 90px;
  padding-bottom: 90px;
}

.about {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
}

.about-image img {
  width: 100%;
  height: 460px;
  object-fit: cover;
  border-radius: 32px;
  box-shadow: 0 20px 40px rgba(17, 12, 12, 0.1);
}

.about-copy h2,
.cuisine-band h2,
.section-heading,
.menu-preview h2,
.gallery h2,
.testimonials h2,
.contact-copy h2 {
  font-size: clamp(2rem, 3vw, 3.2rem);
  margin: 12px 0 16px;
}

.about-copy p,
.contact-copy p,
.highlight-card p,
.testimonial-card,
.dish-content p {
  color: #50413f;
  line-height: 1.7;
}

.cuisine-band {
  background: #2b1c1c;
  color: #fff;
}

.cuisine-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 22px;
  margin-top: 30px;
}

.cuisine-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(255, 255, 255, 0.08);
  padding: 28px 20px;
  border-radius: 22px;
  text-align: center;
}

.cuisine-card h3 {
  margin: 0;
  font-size: 1.2rem;
}

.dish-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 28px;
  margin-top: 26px;
}

.dish-card {
  background: #fff;
  border-radius: 28px;
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
}

.dish-card img {
  width: 100%;
  height: 250px;
  object-fit: cover;
}

.dish-content {
  padding: 22px 20px 26px;
}

.dish-content h3 {
  font-size: 1.7rem;
  margin: 0 0 8px;
}

.menu-preview {
  background: #f2e7d8;
}

.menu-list {
  margin-top: 26px;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.menu-item {
  background: #fff;
  border: 1px solid rgba(123, 30, 30, 0.08);
  border-radius: 18px;
  padding: 18px 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
}

.menu-item h4 {
  margin: 0 0 4px;
  font-size: 1.1rem;
}

.menu-item span {
  color: #6d5b56;
  font-size: 0.9rem;
}

.menu-item strong {
  color: #7a1f1f;
  font-size: 1.2rem;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  margin-top: 24px;
}

.gallery-grid img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  border-radius: 22px;
  box-shadow: 0 18px 36px rgba(0, 0, 0, 0.08);
}

.highlight-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.highlight-card {
  background: #fff;
  border: 1px solid rgba(122, 31, 31, 0.08);
  border-radius: 26px;
  padding: 28px 24px;
  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.05);
}

.highlight-card h3 {
  margin: 0 0 10px;
  font-size: 1.7rem;
}

.testimonials {
  background: #f1e5d2;
}

.testimonial-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  margin-top: 24px;
}

.testimonial-card {
  background: #fff;
  border-radius: 24px;
  padding: 24px 20px;
  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.04);
}

.testimonial-card .quote {
  font-size: 1.05rem;
  margin: 0 0 16px;
  line-height: 1.8;
}

.testimonial-card span {
  font-weight: 800;
  color: #7a1f1f;
}

.contact-section {
  background: #2b1c1c;
  color: #fff;
}

.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1.1fr;
  gap: 60px;
  align-items: center;
}

.contact-list {
  margin-top: 24px;
  display: grid;
  gap: 8px;
  color: rgba(255, 255, 255, 0.9);
}

.booking-form {
  background: #fff;
  color: #2b1c1c;
  border-radius: 28px;
  padding: 24px;
  display: grid;
  gap: 14px;
  box-shadow: 0 24px 50px rgba(0, 0, 0, 0.14);
}

.booking-form input,
.booking-form textarea {
  width: 100%;
  border: 1px solid #e4d9ca;
  border-radius: 14px;
  padding: 14px 16px;
  background: #fffdf9;
}

.form-button {
  width: fit-content;
}

.site-footer {
  background: #1b1414;
  color: #fff;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px 0;
  gap: 16px;
}

@media (max-width: 900px) {
  .nav {
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px;
  }

  .nav-links {
    order: 3;
    width: 100%;
    justify-content: center;
    flex-wrap: wrap;
  }

  .hero,
  .about,
  .contact-grid,
  .dish-grid,
  .highlight-grid,
  .testimonial-grid,
  .gallery-grid,
  .cuisine-grid,
  .menu-list {
    grid-template-columns: 1fr;
  }

  .brand {
    width: 100%;
    text-align: center;
  }

  .hero {
    padding-top: 50px;
  }

  .footer-inner {
    flex-direction: column;
    text-align: center;
  }
}
